model Business {
  id          String   @id @default(cuid())
  name        String
  vertical    String   // "med_spa", "boutique_gym", "personal_trainer"
  createdAt   DateTime @default(now())

  leads       Lead[]
  revenue     Revenue[]
  messages    MessageLog[]
}

model Lead {
  id                 String   @id @default(cuid())
  businessId         String
  business           Business @relation(fields: [businessId], references: [id])

  firstName          String
  lastName           String?
  email              String?
  phone              String?

  source             String   // "instagram", "facebook", "google", "tiktok", "referral", "website"
  campaign           String?
  status             String   // "new", "contacted", "scheduled", "closed", "lost"

  estimatedValue     Float    @default(0)
  closedValue        Float    @default(0)

  lostReason         String?
  createdAt          DateTime @default(now())
  closedAt           DateTime?
  updatedAt          DateTime @updatedAt
}

model Revenue {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  amount      Float
  source      String?  // "lead", "membership", "package", "consultation"
  leadId      String?
  createdAt   DateTime @default(now())
}

model MessageLog {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  type        String   // "call", "sms", "email"
  direction   String   // "inbound", "outbound"
  status      String   // "answered", "missed", "sent", "failed", "received"
  leadId      String?
  createdAt   DateTime @default(now())
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
